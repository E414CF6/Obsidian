# Obsidian Stats HTTP REST API 엔드포인트 (기본 포트: 4000)
# Obsidian 플러그인이 실행 중인 주소로 지정하면 /api/* 라우트가 RSA-SHA256 서명으로 안전하게 프록시 조회합니다.
REMOTE_API_URL=http://127.0.0.1:4000

# ==============================================================================
# RSA-SHA256 디지털 서명 인증 설정 (Obsidian stats 모듈 연동 시 필수)
# ==============================================================================
# 1. 파일 경로 지정 (기본 탐색 경로: ./keys/private_key.pem, ../run/plugins/Obsidian/keys/private_key.pem)
RSA_PRIVATE_KEY_PATH=../run/plugins/Obsidian/keys/private_key.pem

# 2. Vercel 등 클라우드 배포 시 PEM 문자열 직접 등록 (줄바꿈은 \n 이스케이프 사용)
# RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# (선택) Obsidian config.yml의 stats.auth.api-key 를 설정한 경우 함께 지정
# API_SECRET_KEY=your-shared-api-key
# REQUIRE_API_KEY=false

# (선택) REMOTE_API_URL 미설정 시 레거시 MariaDB 직접 조회용 설정
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME_WC=msdwc
# DB_NAME_GL=msdgl
